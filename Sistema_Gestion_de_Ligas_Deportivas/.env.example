APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Proxies de confianza separados por comas (túnel o balanceador). Por defecto, solo el del mismo equipo
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgld_db
DB_USERNAME=root
DB_PASSWORD=

# Administrador de MariaDB para `php artisan sgld:usuario-bd` y para los respaldos (volcado y restauración, HU-009).
# En producción configúralo: la cuenta de la aplicación no puede volcar los triggers de la auditoría
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=

# Respaldos cifrados (HU-009). RESPALDO_DISCO: respaldos (local) o r2. La clave es base64 de 32 bytes
# y debe guardarse también FUERA del servidor: sin ella los respaldos no se pueden restaurar
RESPALDO_DISCO=
RESPALDO_CLAVE=
RESPALDO_VOLCADO=
RESPALDO_IMPORTACION=
RESPALDO_BASE_RESTAURACION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción, con HTTPS, va en true: la cookie de sesión no viaja sin cifrar
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# Credenciales solo para el Mailpit local (README, sección 10); no son secretos.
# En producción se definen en el .env del servidor, nunca en el repositorio.
MAIL_USERNAME=sgld
MAIL_PASSWORD=mailpit-local
# En producción va en true: impide enviar las credenciales sin cifrar.
MAIL_REQUIRE_TLS=false
# Marcador: la dirección real se define cuando se decida el hospedaje.
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="Sistema de Gestión de Ligas Deportivas"

# Minutos que un partido ocupa su cancha (HU-025); provisional hasta que lo confirme el Product Owner
PARTIDO_DURACION_MINUTOS=120

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
