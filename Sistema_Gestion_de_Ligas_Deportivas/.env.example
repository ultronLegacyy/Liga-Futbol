APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgld_db
DB_USERNAME=root
DB_PASSWORD=

# Administrador de MariaDB solo para `php artisan sgld:usuario-bd` (crea el usuario de la aplicación); déjalo vacío si no lo usas
DB_ADMIN_USERNAME=
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# Credenciales solo para el Mailpit local (README, sección 10); no son secretos.
# En producción se definen en el .env del servidor, nunca en el repositorio.
MAIL_USERNAME=sgld
MAIL_PASSWORD=mailpit-local
# En producción va en true: impide enviar las credenciales sin cifrar.
MAIL_REQUIRE_TLS=false
# Marcador: la dirección real se define cuando se decida el hospedaje.
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="Sistema de Gestión de Ligas Deportivas"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

HASH_DRIVER=argon2id
