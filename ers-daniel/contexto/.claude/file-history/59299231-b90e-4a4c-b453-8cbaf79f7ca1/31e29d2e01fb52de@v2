{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Logo fijo de Arch (en vez del logo de CachyOS que detecta por defecto).
    // No se fija width/height/padding a mano: fastfetch relee el tamaño real
    // de la terminal en cada ejecución, así que el layout se autoajusta solo
    // cuando la ventana es más chica o más grande.
    "logo": {
        "source": "arch",
        "padding": {
            "top": 1
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "wm",
        "terminal",
        "cpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}
