2F8;swimlaneFillColor=#ffffff;" vertex="1" parent="p1-pool"><mxGeometry x="30" y="420" width="2600.0" height="140" as="geometry"/></mxCell><mxCell id="p1-lane4" value="Comisión Disciplinaria" style="swimlane;startSize=40;horizontal=0;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#F3F2F8;swimlaneFillColor=#ffffff;" vertex="1" parent="p1-pool"><mxGeometry x="30" y="560" width="2600.0" height="140" as="geometry"/></mxCell><mxCell id="p1-s1" value="Inicio del partido&lt;br&gt;programado" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;fontSize=11;outline=standard;symbol=timer;" vertex="1" parent="p1-lane1"><mxGeometry x="127" y="52" width="36" height="36" as="geometry"/></mxCell><mxCell id="p1-t1" value="Abrir la cédula del partido asignado en el celular" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane1"><mxGeometry x="250" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t2" value="Precargar alineaciones y verificar la elegibilidad de cada jugador" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=service;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="250" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-g1" value="¿Todos los jugadores&lt;br&gt;están habilitados?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;align=center;perimeter=rhombusPerimeter;outlineConnect=0;fontSize=11;outline=none;symbol=none;gwType=exclusive;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="p1-lane2"><mxGeometry x="480" y="45" width="50" height="50" as="geometry"/></mxCell><mxCell id="p1-t3" value="Retirar o sustituir al jugador no elegible (el Sistema indica la regla)" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane0"><mxGeometry x="430" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t4" value="Cotejar credenciales y marcar asistencia y números de camiseta" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane1"><mxGeometry x="610" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t5" value="Registrar goles, tarjetas e incidencias durante el partido" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane1"><mxGeometry x="790" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t6" value="Revisar el resumen, recabar la firma de los capitanes y cerrar la cédula" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane1"><mxGeometry x="970" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t7" value="Validar la consistencia de la cédula" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=service;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="970" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-g2" value="¿Hay inconsistencias?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;align=center;perimeter=rhombusPerimeter;outlineConnect=0;fontSize=11;outline=none;symbol=none;gwType=exclusive;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="p1-lane2"><mxGeometry x="1200" y="45" width="50" height="50" as="geometry"/></mxCell><mxCell id="p1-t8" value="Guardar la cédula en una sola transacción y avisar a la Secretaría" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=service;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="1330" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t9" value="Validar el resultado del partido" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane3"><mxGeometry x="1330" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t10" value="Marcar el resultado como oficial y recalcular la tabla" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=service;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="1510" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-g3" value="¿Hay expulsiones o&lt;br&gt;incidencias&lt;br&gt;disciplinarias?" style="points=[[0.25,0.25,0],[0.5,0,0],[0.75,0.25,0],[1,0.5,0],[0.75,0.75,0],[0.5,1,0],[0.25,0.75,0],[0,0.5,0]];shape=mxgraph.bpmn.gateway2;html=1;labelBackgroundColor=#ffffff;align=center;perimeter=rhombusPerimeter;outlineConnect=0;fontSize=11;outline=none;symbol=none;gwType=exclusive;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="p1-lane2"><mxGeometry x="1740" y="45" width="50" height="50" as="geometry"/></mxCell><mxCell id="p1-e1" value="Resultado oficial&lt;br&gt;publicado" style="points=[[0.145,0.145,0],[0.5,0,0],[0.855,0.145,0],[1,0.5,0],[0.855,0.855,0],[0.5,1,0],[0.145,0.855,0],[0,0.5,0]];shape=mxgraph.bpmn.event;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;perimeter=ellipsePerimeter;outlineConnect=0;aspect=fixed;fontSize=11;outline=end;symbol=terminate;" vertex="1" parent="p1-lane2"><mxGeometry x="1927" y="52" width="36" height="36" as="geometry"/></mxCell><mxCell id="p1-t11" value="Revisar el expediente, celebrar la audiencia y dictaminar la sanción" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane4"><mxGeometry x="1870" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t12" value="Calcular la vigencia, actualizar castigados y bloquear al sancionado" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=service;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="2050" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t13" value="Autorizar la publicación de la sanción" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=user;" vertex="1" parent="p1-lane4"><mxGeometry x="2050" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t14" value="Publicar el boletín de castigados y avisar por correo al delegado" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;container=1;expand=0;collapsible=0;fontSize=12;taskMarker=send;fillColor=#EDE9F7;" vertex="1" parent="p1-lane2"><mxGeometry x="2230" y="30" width="150" height="80" as="geometry"/></mxCell><mxCell id="p1-t15" value="Recibir el aviso de la sanción (puede inconformarse: proceso 4)" style="shape=mxgraph.bpmn.task2;whiteSpace=wrap;rectStyle=rounded;size=10;html=1;cont